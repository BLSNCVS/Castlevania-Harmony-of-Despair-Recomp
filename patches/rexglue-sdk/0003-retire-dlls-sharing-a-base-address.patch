+void KernelState::EvictOverlappingModules(UserModule& module) {
+  // An Xbox 360 relocates a DLL whose base address is taken (the images have
+  // .reloc sections). Recompiled code is fixed to its base, so DLLs that share
+  // one can't both be loaded: Harmony of Despair's DLC bosses at 8BF00000 do,
+  // and the game loads the next chapter's DLLs before freeing the last one's.
+  // The console would never run the old copy again before freeing it, so retire
+  // it: its image was just overwritten by LoadFromFile anyway.
+  auto* xex = module.xex_module();
+  const uint32_t begin = xex->base_address();
+  const uint32_t end = begin + xex->image_size();
+  auto global_lock = global_critical_region_.Acquire();
+  for (auto& existing : user_modules_) {
+    if (existing.get() == &module || existing->evicted() || !existing->is_dll_module()) {
+      continue;
+    }
+    auto* other = existing->xex_module();
+    const uint32_t other_begin = other->base_address();
+    const uint32_t other_end = other_begin + other->image_size();
+    if (begin >= other_end || other_begin >= end) {
+      continue;
+    }
+    REXSYS_WARN("Loading '{}' over '{}' ({:08X}-{:08X}); retiring the old module",
+                module.path(), existing->path(), other_begin, other_end);
+    existing->set_evicted();
+    other->DisownImage();
+    if (auto recomp = FindRecompiledModule(existing->path())) {
+      const std::string& key = recomp->guest_path;
+      if (auto cleared_range = function_dispatcher_->UnregisterModule(key)) {
+        for (auto& km : kernel_modules_) {
+          km->InvalidateThunkCacheInRange(cleared_range->first, cleared_range->second);
+        }
+      }
+      auto lib_it = module_libraries_.find(key);
+      if (lib_it != module_libraries_.end()) {
+        deferred_unload_libraries_.push_back(std::move(lib_it->second));
+        module_libraries_.erase(lib_it);
+      }
+    }
+  }
+}
