index 9b9cf9e..7e9799d 100644
--- a/include/rex/system/kernel_state.h
+++ b/include/rex/system/kernel_state.h
@@ -333,6 +333,15 @@ class KernelState {
   AchievementManager& achievements() { return achievement_manager_; }
   const AchievementManager& achievements() const { return achievement_manager_; }
 
+  // The app's achievement list for XamShowAchievementsUI. It runs on the UI
+  // thread and calls `closed` once the player leaves it. Without one the call
+  // does nothing, as before.
+  using SystemUIHandler = std::function<void(std::function<void()> closed)>;
+  void SetAchievementsUIHandler(SystemUIHandler handler) {
+    achievements_ui_handler_ = std::move(handler);
+  }
+  const SystemUIHandler& achievements_ui_handler() const { return achievements_ui_handler_; }
+
   using AchievementUnlockCallback = std::function<void(const AchievementInfo&)>;
   AchievementListenerHandle RegisterAchievementUnlockCallback(AchievementUnlockCallback cb);
 
@@ -387,6 +396,7 @@ class KernelState {
   uint32_t kernel_guest_globals_ = 0;
 
   AchievementManager achievement_manager_;
+  SystemUIHandler achievements_ui_handler_;
 
   std::atomic<bool> dispatch_thread_running_;
   std::atomic<bool> terminating_title_{false};
