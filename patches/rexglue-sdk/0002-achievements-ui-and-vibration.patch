@@ -261,6 +262,11 @@ X_RESULT InputSystem::SetState(uint32_t user_index, X_INPUT_VIBRATION* vibration
   std::vector<DeviceId> ids;
   assignment_->DevicesForUser(user_index, ids);
 
+  X_INPUT_VIBRATION stopped{};
