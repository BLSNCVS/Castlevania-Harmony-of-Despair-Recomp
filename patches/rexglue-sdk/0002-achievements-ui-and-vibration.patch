diff --git a/src/kernel/xam/xam_ui.cpp b/src/kernel/xam/xam_ui.cpp
index 5a572ce..6d3cb1b 100644
--- a/src/kernel/xam/xam_ui.cpp
+++ b/src/kernel/xam/xam_ui.cpp
@@ -560,6 +560,30 @@ uint32_t XamShowMessageBoxUIEx_entry() {
   return 0;
 }
 
+u32 XamShowAchievementsUI_entry(u32 user_index) {
+  auto* kernel_state = REX_KERNEL_STATE();
+  auto* app_context = kernel_state->emulator()->app_context();
+  const auto& handler = kernel_state->achievements_ui_handler();
+  if (!handler || !app_context) {
+    REXKRNL_WARN("XamShowAchievementsUI({}): no achievements UI", uint32_t(user_index));
+    return X_ERROR_SUCCESS;
+  }
+  // The guide opens over the running title, which pauses on XN_SYS_UI.
+  kernel_state->BroadcastNotification(0x9, true);
+  ++xam_dialogs_shown_;
+  app_context->CallInUIThread([handler]() {
+    handler([]() {
+      --xam_dialogs_shown_;
+      REX_KERNEL_STATE()->BroadcastNotification(0x9, false);
+    });
+  });
+  return X_ERROR_SUCCESS;
+}
+
+u32 XamShowAchievementsUIEx_entry(u32 user_index) {
+  return XamShowAchievementsUI_entry(user_index);
+}
+
 }  // namespace xam
 }  // namespace kernel
 }  // namespace rex
