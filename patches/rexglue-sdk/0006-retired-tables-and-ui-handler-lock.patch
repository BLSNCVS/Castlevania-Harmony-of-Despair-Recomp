diff --git a/src/system/xmemory.cpp b/src/system/xmemory.cpp
index ada25db..9a43d22 100644
--- a/src/system/xmemory.cpp
+++ b/src/system/xmemory.cpp
@@ -852,7 +852,11 @@ bool Memory::DestroyFunctionTable(uint32_t code_base) {
       return false;
     }
     if (it->host_table) {
-      *it->host_table = nullptr;
+      // A guest thread may still be finishing the retired module's code
+      // (see KernelState::EvictOverlappingModules), so the module keeps
